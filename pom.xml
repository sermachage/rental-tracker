<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = the Maven "Project Object Model".
  It tells Maven: what our project is, which libraries (dependencies) it needs,
  and which plugins run during the build (compile, test, coverage).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Project coordinates: groupId + artifactId + version uniquely identify it -->
  <groupId>com.rental</groupId>
  <artifactId>rental-tracker</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <!-- We target Java 21 -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <!-- Fully-qualified name of the class with main(); used by exec plugin -->
    <main.class>com.rental.App</main.class>
  </properties>

  <dependencies>
    <!-- JDBC driver for SQLite: lets Java talk to a .db file.
         "Infrastructure" layer is the only place that should use it directly. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>

    <!-- JUnit 5: the test framework. scope=test means it is NOT shipped with the app. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Surefire runs the unit tests during `mvn test` / `mvn verify` -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- JaCoCo measures which lines of code the tests executed.
           The HTML report is written to docs/coverage so we can commit it
           (a deliverable). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <!-- Attach the JaCoCo agent to the test JVM so it can record coverage -->
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <!-- After tests, generate the HTML report -->
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <outputDirectory>${project.basedir}/docs/coverage</outputDirectory>
            </configuration>
          </execution>
          <!-- A "check" rule enforcing 100% will be added in the final step,
               once the code exists. -->
        </executions>
      </plugin>

      <!-- Lets us run the CLI with: mvn -q compile exec:java -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>